# S7-02: production images for both Fargate services (S7-01's unified
# compute decision). Build context is kbc_analyzer/ (this file's own
# directory), not backend/ or frontend/ alone — the `web` target needs
# both. Build with:
#   docker build -f Dockerfile.prod --target web    -t kbc-analyzer-web    .
#   docker build -f Dockerfile.prod --target worker -t kbc-analyzer-worker .
#
# One Dockerfile, one shared python-deps/runtime-base per S7-02's
# shared-base decision (see docs/tickets/S7-02-...): web and worker run
# identical dependency versions, verified against the same install, not
# two Dockerfiles that can silently drift apart. They diverge only in
# the `web`/`worker` final stages below, where `web` alone needs the
# compiled frontend baked in.

# ---- Stage: frontend production build (only feeds the `web` target) ----
FROM node:22-alpine AS frontend-build
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json ./
COPY frontend/vite.config.ts frontend/index.html frontend/components.json ./
COPY frontend/public ./public
COPY frontend/src ./src
# VITE_API_URL is a Vite BUILD-TIME env var (import.meta.env is inlined
# into the compiled JS, not read at container runtime) — S7-04 shipped
# without this ARG, so every image silently baked in api.ts's dev
# fallback ("http://localhost:8000") regardless of what the ECS task's
# runtime environment set. Real production symptom: registration and
# Google sign-in both failed on mymble.be with zero requests ever
# reaching the backend (confirmed via CloudWatch — no /api/auth/* POSTs
# in the logs at all), because the browser was POSTing to the visitor's
# own machine, not the deployed backend. No default here — a missing
# build arg should fail loudly, not silently reproduce this bug again.
# Defaults to "" (same-origin, relative paths — api.ts does
# `${API_URL}${path}`, so an empty string produces plain "/api/..."
# requests that fetch() resolves against whatever origin served the
# page). Correct default for this architecture: FastAPI serves both the
# API and the compiled frontend from one origin (S7-02), so the frontend
# never actually needs to know its own domain. Override only for a setup
# where the API is genuinely on a different origin than the static
# assets. Promoted from ARG to ENV because Vite's import.meta.env only
# sees real environment variables at build time, not Docker build args.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- Stage: Python dependencies, built once in a venv so build tools
# (build-essential, libpq-dev — needed to compile cryptography/psycopg
# wheels) never end up in the final image ----
FROM python:3.12-slim AS python-deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt

# ---- Stage: shared runtime base for both web and worker ----
FROM python:3.12-slim AS runtime-base
WORKDIR /app
COPY --from=python-deps /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Explicit allowlist, not `COPY backend/ .` — backend/ also holds
# eb_session.json, private.pem, and certs/ (real Enable Banking secret
# material and a TLS key), which must never be able to land in an image
# that gets pushed to a registry. .dockerignore already excludes them,
# but this doesn't rely on that being kept correct forever.
COPY backend/app ./app
COPY backend/kbc_analyzer ./kbc_analyzer
# backend/ops/ (not backend/scripts/ — that's dev-only debug tooling,
# excluded below): production-safe one-shot operator scripts that must
# actually exist inside the real container to be runnable via ECS Exec.
COPY backend/ops ./ops
COPY backend/alembic.ini .

# S4-09 Item 1's non-root user, carried into both production targets —
# same reasoning as the dev Dockerfile: neither service should run as
# root in a container that reaches real bank data.
RUN addgroup --system appgroup && \
    adduser --system --ingroup appgroup appuser
USER appuser

# ---- Target: worker (Celery — no HTTP, no frontend) ----
FROM runtime-base AS worker
CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=info"]

# ---- Target: web (FastAPI + compiled frontend, served by the backend) ----
FROM runtime-base AS web
COPY --from=frontend-build --chown=appuser:appgroup /fe/dist ./static
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
