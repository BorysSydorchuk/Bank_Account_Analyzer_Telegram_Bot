# Copy this file to .env and fill in real values. .env is gitignored.
# This single file is read by docker-compose (for Postgres + service wiring)
# and by the backend's own load_dotenv() call (python-dotenv walks up parent
# directories, so it finds this file even when run from backend/).

# ── Enable Banking (KBC Open Banking) ──────────────────────────────────────
# App ID from the Enable Banking developer portal
ENABLEBANKING_APP_ID=your_application_id_here
# Path to the RSA private key downloaded from the portal, relative to /backend
ENABLEBANKING_PRIVATE_KEY_PATH=private.pem

# ── Google Gemini (not used yet in Sprint 1, kept for the existing CLI/bot) ─
GEMINI_API_KEY=AIza...

# ── Telegram bot (existing feature, untouched by the web app) ─────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here

# ── Settings encryption (S2-03) ─────────────────────────────────────────────
# Fernet key used to encrypt LLM provider API keys stored in the `settings`
# table at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this after keys are saved makes them undecryptable —
# treat it like a password, back it up, never commit the real value.
SETTINGS_SECRET=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=kbc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kbc_analyzer
POSTGRES_PORT=5432
# Full connection string the backend uses (SQLAlchemy/psycopg). Host "db" is
# the docker-compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://kbc:change_me@db:5432/kbc_analyzer

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Origin the API allows CORS requests from (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend (Vite dev server) ──────────────────────────────────────────────
FRONTEND_PORT=5173
# Base URL the React app calls for API requests
VITE_API_URL=http://localhost:8000