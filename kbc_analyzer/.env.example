# Copy this file to .env and fill in real values. .env is gitignored.
# This single file is read by docker-compose (for Postgres + service wiring)
# and by the backend's own load_dotenv() call (python-dotenv walks up parent
# directories, so it finds this file even when run from backend/).

# ── Enable Banking (KBC Open Banking) ──────────────────────────────────────
# App ID from the Enable Banking developer portal
ENABLEBANKING_APP_ID=your_application_id_here
# Path to the RSA private key downloaded from the portal, relative to /backend
ENABLEBANKING_PRIVATE_KEY_PATH=private.pem

# ── Google Gemini (existing CLI/bot; also used by scripts/smoke_test_providers.py) ─
GEMINI_API_KEY=AIza...

# ── Anthropic Claude (S2-04; only used by scripts/smoke_test_providers.py — the
# app itself reads provider keys from the encrypted settings table, set via the
# Settings page, not from here) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram bot (existing feature, untouched by the web app) ─────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here

# ── Legacy CLI/bot's account-specific categorization rules (S5-07, optional) ─
# kbc_analyzer/analysis.py's Gemini prompt used to hardcode real IBANs and a
# real counterparty name for these rules — moved here so source never carries
# real financial identifiers. Every one of these is optional; a rule is only
# added to the prompt if its variable is set, so a fresh checkout with none
# of these configured just runs without account-specific rules. The
# investing-account rule needs BOTH its variables set to take effect — the
# name, not the IBAN, is what actually matches real transaction
# descriptions (IBANs never appear there); the IBAN alone was a no-op
# (corrected S5-07 review bounce).
KBC_INVESTING_ACCOUNT_IBAN=
KBC_INVESTING_ACCOUNT_HOLDER_NAME=
KBC_SELF_TRANSFER_IBAN_A=
KBC_SELF_TRANSFER_IBAN_B=
KBC_SAVINGS_ACCOUNT_IBAN=
KBC_LAUNDRY_COUNTERPARTY_NAME=

# ── Google OAuth sign-in (S6-03) ────────────────────────────────────────────
# From an OAuth 2.0 Client ID (type: Web application) in the Google Cloud
# Console. Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI
# below, or Google rejects the request outright.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Session cookie (S6-01) ──────────────────────────────────────────────────
# "true" only once the app is served over real HTTPS (Sprint 7) — a browser
# refuses to ever send a Secure cookie back to a plain http:// origin, which
# is every environment this app runs in today.
COOKIE_SECURE=false

# ── Settings encryption (S2-03) ─────────────────────────────────────────────
# Fernet key used to encrypt LLM provider API keys stored in the `settings`
# table at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this after keys are saved makes them undecryptable —
# treat it like a password, back it up, never commit the real value.
SETTINGS_SECRET=

# ── Background jobs (S3-03) ──────────────────────────────────────────────────
# Redis backs both the Celery message broker (queueing tasks) and its result
# backend (storing task state) — separate DB indexes (/0, /1) so a `redis-cli
# FLUSHDB` against one during debugging can't wipe the other by accident.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=kbc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kbc_analyzer
POSTGRES_PORT=5432
# Full connection string the backend uses (SQLAlchemy/psycopg). Host "db" is
# the docker-compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://kbc:change_me@db:5432/kbc_analyzer

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Origin the API allows CORS requests from (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# ── Frontend (Vite dev server) ──────────────────────────────────────────────
FRONTEND_PORT=5173
# Base URL the React app calls for API requests
VITE_API_URL=http://localhost:8000

# ── Transactional email (S7-08, provider switched to Resend at S8-05) ────────
# app/email_service.py sends via Resend. Locally, a real RESEND_API_KEY is
# needed on the machine running the backend to actually send — there's no
# local email emulator in this stack; without a real key, sends fail loudly
# (a real Resend auth error), same as any other missing local credential.
# Production reads the real key from Secrets Manager (infra/ecs.tf).
EMAIL_SENDER_ADDRESS=no-reply@mymble.be
RESEND_API_KEY=